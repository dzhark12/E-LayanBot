# Salin sebagai .env. Ganti semua secret sebelum dijalankan.
POSTGRES_DB=elayan_db
POSTGRES_USER=postgres
# Gunakan huruf dan angka saja agar DATABASE_URL tidak rusak.
POSTGRES_PASSWORD=ganti_dengan_password_database_kamu
# Host "db" adalah nama service PostgreSQL di docker-compose.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}

# Minimal 32 karakter acak.
BOT_API_TOKEN=ganti_dengan_token_acak_minimal_32_karakter
BOT_API_URL=http://app:8080
# Minimal 32 karakter acak. Jangan diganti setelah data mulai tersimpan.
WA_HASH_KEY=ganti_dengan_hash_key_acak_minimal_32_karakter
ADMIN_USERNAME=admin
# Minimal 12 karakter.
ADMIN_PASSWORD=ganti_dengan_password_admin_yang_kuat
# Opsional. Isi dengan minimal 32 karakter acak untuk mengaktifkan reset di halaman login.
ADMIN_RECOVERY_CODE=BAPAKERPANDITOLONGRESPONWHATSAPPKELOMPOKSAYA
SESSION_COOKIE_SECURE=false
HTTP_PORT=8080

# Tetapkan bersama Sekdes sebelum menerima dokumen warga.
ATTACHMENT_RETENTION_DAYS=30

# Opsional. Kosongkan GEMINI_API_KEY untuk menonaktifkan asisten AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_PER_HOUR=10
VILLAGE_NAME=Sabah Balau
